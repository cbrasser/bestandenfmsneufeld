{
  "fixtures": {
    "fms-student": {
      "studentInfo": { "name": "Test", "division": "FMS" },
      "currentYear": 1,
      "years": {
        "1": { "subjects": [{ "id": "deutsch", "name": "Deutsch", "grades": [] }] },
        "2": { "subjects": [] },
        "3": { "subjects": [] },
        "4": { "subjects": [] }
      }
    }
  },
  "scenarios": [
    {
      "name": "a new account starts at version 1 and loads back",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "createCode", "device": "A" },
        { "action": "expectDevice", "device": "A", "status": "saved", "failure": null, "version": 1, "unsynced": false },
        { "action": "expectCloud", "version": 1, "grades": [] }
      ]
    },
    {
      "name": "two devices alternating edits see each other's grades on focus",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "createCode", "device": "A" },
        { "action": "connect", "device": "B" },
        { "action": "expectDevice", "device": "B", "status": "saved", "version": 1, "unsynced": false, "grades": [] },

        { "action": "addGrade", "device": "A", "value": 5 },
        { "action": "expectDevice", "device": "A", "status": "saving", "unsynced": true },
        { "action": "saveDelayElapsed", "device": "A" },
        { "action": "expectDevice", "device": "A", "status": "saved", "version": 2, "unsynced": false },
        { "action": "expectCloud", "version": 2, "grades": [5] },
        { "action": "focus", "device": "B" },
        { "action": "expectDevice", "device": "B", "status": "saved", "version": 2, "unsynced": false, "grades": [5] },

        { "action": "addGrade", "device": "B", "value": 4 },
        { "action": "saveDelayElapsed", "device": "B" },
        { "action": "expectCloud", "version": 3, "grades": [5, 4] },
        { "action": "focus", "device": "A" },
        { "action": "expectDevice", "device": "A", "status": "saved", "version": 3, "unsynced": false, "grades": [5, 4] },

        { "action": "focus", "device": "A" },
        { "action": "focus", "device": "B" },
        { "action": "expectCloud", "version": 3, "grades": [5, 4] }
      ]
    },
    {
      "name": "opening a device takes newer cloud data",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "createCode", "device": "A" },
        { "action": "connect", "device": "B" },
        { "action": "addGrade", "device": "A", "value": 5 },
        { "action": "saveDelayElapsed", "device": "A" },
        { "action": "open", "device": "B" },
        { "action": "expectDevice", "device": "B", "status": "saved", "version": 2, "unsynced": false, "grades": [5] },
        { "action": "expectCloud", "version": 2 }
      ]
    },
    {
      "name": "a stale save is refused and neither side loses its grades",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "createCode", "device": "A" },
        { "action": "connect", "device": "B" },
        { "action": "addGrade", "device": "A", "value": 5 },
        { "action": "saveDelayElapsed", "device": "A" },

        { "action": "addGrade", "device": "B", "value": 3 },
        { "action": "saveDelayElapsed", "device": "B" },
        { "action": "expectDevice", "device": "B", "status": "error", "failure": "conflict", "version": 1, "unsynced": true, "grades": [3] },
        { "action": "expectCloud", "version": 2, "grades": [5] },

        { "action": "focus", "device": "B" },
        { "action": "expectDevice", "device": "B", "status": "error", "failure": "conflict", "unsynced": true, "grades": [3] },
        { "action": "open", "device": "B" },
        { "action": "expectDevice", "device": "B", "status": "error", "failure": "conflict", "unsynced": true, "grades": [3] },
        { "action": "expectCloud", "version": 2, "grades": [5] }
      ]
    },
    {
      "name": "the save call never overwrites on a version mismatch",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "createCode", "device": "A" },
        { "action": "saveCall", "expectedVersion": 1, "grades": [5], "result": { "status": "saved", "version": 2 } },
        { "action": "saveCall", "expectedVersion": 1, "grades": [1], "result": { "status": "conflict", "version": 2 } },
        { "action": "saveCall", "expectedVersion": 3, "grades": [1], "result": { "status": "conflict", "version": 2 } },
        { "action": "expectCloud", "version": 2, "grades": [5] },
        { "action": "saveCall", "expectedVersion": 2, "grades": [5, 6], "result": { "status": "saved", "version": 3 } },
        { "action": "expectCloud", "version": 3, "grades": [5, 6] }
      ]
    },
    {
      "name": "of two parallel saves at one version, exactly one is saved",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "createCode", "device": "A" },
        { "action": "parallelSaveCalls", "expectedVersion": 1, "grades": [[5], [3]], "statuses": ["conflict", "saved"] },
        { "action": "expectCloud", "version": 2 }
      ]
    },
    {
      "name": "an unknown code is reported and changes nothing",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "connect", "device": "A", "code": "UNKN-OWNC-ODE2-3456", "result": "unknown_code" },
        { "action": "expectDevice", "device": "A", "connected": false, "version": null, "unsynced": false, "grades": [] },
        { "action": "expectCloud", "code": "UNKNOWNCODE23456", "exists": false },
        { "action": "saveCall", "code": "UNKNOWNCODE23456", "expectedVersion": 1, "grades": [5], "result": { "status": "unknown_code" } },
        { "action": "expectCloud", "code": "UNKNOWNCODE23456", "exists": false }
      ]
    },
    {
      "name": "old website copies still load and save, and their saves raise the version",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "createCode", "device": "A" },
        { "action": "connect", "device": "B" },
        { "action": "legacySave", "grades": [5], "result": true },
        { "action": "legacyLoad", "grades": [5] },
        { "action": "expectCloud", "version": 2, "grades": [5] },

        { "action": "addGrade", "device": "B", "value": 3 },
        { "action": "saveDelayElapsed", "device": "B" },
        { "action": "expectDevice", "device": "B", "status": "error", "failure": "conflict", "unsynced": true },
        { "action": "expectCloud", "version": 2, "grades": [5] },

        { "action": "focus", "device": "A" },
        { "action": "expectDevice", "device": "A", "status": "saved", "version": 2, "grades": [5] },

        { "action": "legacySave", "code": "UNKNOWNCODE23456", "grades": [5], "result": false },
        { "action": "legacyLoad", "code": "UNKNOWNCODE23456", "exists": false }
      ]
    },
    {
      "name": "a save that fails stays unsynced and goes through on the next focus or open",
      "steps": [
        { "action": "open", "device": "A", "fixture": "fms-student" },
        { "action": "createCode", "device": "A" },
        { "action": "setOffline", "device": "A", "offline": true },
        { "action": "addGrade", "device": "A", "value": 5 },
        { "action": "saveDelayElapsed", "device": "A" },
        { "action": "expectDevice", "device": "A", "status": "error", "failure": "unreachable", "unsynced": true, "grades": [5] },
        { "action": "expectCloud", "version": 1, "grades": [] },

        { "action": "setOffline", "device": "A", "offline": false },
        { "action": "focus", "device": "A" },
        { "action": "expectDevice", "device": "A", "status": "saved", "failure": null, "version": 2, "unsynced": false },
        { "action": "expectCloud", "version": 2, "grades": [5] },

        { "action": "setOffline", "device": "A", "offline": true },
        { "action": "addGrade", "device": "A", "value": 4 },
        { "action": "saveDelayElapsed", "device": "A" },
        { "action": "setOffline", "device": "A", "offline": false },
        { "action": "open", "device": "A" },
        { "action": "expectDevice", "device": "A", "status": "saved", "version": 3, "unsynced": false },
        { "action": "expectCloud", "version": 3, "grades": [5, 4] }
      ]
    },
    {
      "name": "a tab closed during the save delay saves on the next open",
      "steps": [
        {"action": "open", "device": "A", "fixture": "fms-student"},
        {"action": "createCode", "device": "A"},
        {"action": "addGrade", "device": "A", "value": 5},
        {"action": "expectDevice", "device": "A", "status": "saving", "unsynced": true, "version": 1},
        {"action": "expectCloud", "version": 1, "grades": []},
        {"action": "open", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "saved", "unsynced": false, "version": 2, "grades": [5]},
        {"action": "expectCloud", "version": 2, "grades": [5]}
      ]
    },
    {
      "name": "a failed save survives a restart and goes through on reconnect",
      "steps": [
        {"action": "open", "device": "A", "fixture": "fms-student"},
        {"action": "createCode", "device": "A"},
        {"action": "setOffline", "device": "A", "offline": true},
        {"action": "addGrade", "device": "A", "value": 5},
        {"action": "saveDelayElapsed", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "error", "failure": "unreachable", "unsynced": true},
        {"action": "open", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "error", "failure": "unreachable", "unsynced": true, "version": 1, "grades": [5]},
        {"action": "expectCloud", "version": 1, "grades": []},
        {"action": "reconnect", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "saved", "failure": null, "unsynced": false, "version": 2, "grades": [5]},
        {"action": "expectCloud", "version": 2, "grades": [5]}
      ]
    },
    {
      "name": "a save whose answer got lost is not a conflict with itself",
      "steps": [
        {"action": "open", "device": "A", "fixture": "fms-student"},
        {"action": "createCode", "device": "A"},
        {"action": "loseNextSaveAnswer", "device": "A"},
        {"action": "addGrade", "device": "A", "value": 5},
        {"action": "saveDelayElapsed", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "error", "failure": "unreachable", "unsynced": true, "version": 1},
        {"action": "expectCloud", "version": 2, "grades": [5]},
        {"action": "focus", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "saved", "failure": null, "unsynced": false, "version": 2, "grades": [5]},
        {"action": "expectCloud", "version": 2, "grades": [5]}
      ]
    },
    {
      "name": "a refused save stays a conflict after the cloud moved on with other data",
      "steps": [
        {"action": "open", "device": "A", "fixture": "fms-student"},
        {"action": "createCode", "device": "A"},
        {"action": "connect", "device": "B"},
        {"action": "addGrade", "device": "A", "value": 5},
        {"action": "saveDelayElapsed", "device": "A"},
        {"action": "addGrade", "device": "B", "value": 5},
        {"action": "addGrade", "device": "B", "value": 3},
        {"action": "saveDelayElapsed", "device": "B"},
        {"action": "expectDevice", "device": "B", "status": "error", "failure": "conflict", "unsynced": true, "version": 1, "grades": [5, 3]},
        {"action": "expectCloud", "version": 2, "grades": [5]}
      ]
    },
    {
      "name": "switching year on one device causes no sync and doesn't move the other device",
      "steps": [
        {"action": "open", "device": "A", "fixture": "fms-student"},
        {"action": "createCode", "device": "A"},
        {"action": "connect", "device": "B"},
        {"action": "selectYear", "device": "A", "year": 2},
        {"action": "expectDevice", "device": "A", "status": "saved", "unsynced": false, "version": 1, "selectedYear": 2},
        {"action": "saveDelayElapsed", "device": "A"},
        {"action": "focus", "device": "A"},
        {"action": "expectDevice", "device": "A", "version": 1, "unsynced": false, "selectedYear": 2},
        {"action": "expectCloud", "version": 1, "grades": []},
        {"action": "focus", "device": "B"},
        {"action": "expectDevice", "device": "B", "status": "saved", "version": 1, "unsynced": false, "selectedYear": 1}
      ]
    },
    {
      "name": "each device keeps its own year through the other's edits",
      "steps": [
        {"action": "open", "device": "A", "fixture": "fms-student"},
        {"action": "createCode", "device": "A"},
        {"action": "connect", "device": "B"},
        {"action": "selectYear", "device": "A", "year": 2},
        {"action": "selectYear", "device": "B", "year": 3},
        {"action": "addGrade", "device": "A", "value": 5},
        {"action": "saveDelayElapsed", "device": "A"},
        {"action": "focus", "device": "B"},
        {"action": "expectDevice", "device": "B", "version": 2, "grades": [5], "selectedYear": 3, "unsynced": false},
        {"action": "addGrade", "device": "B", "value": 3},
        {"action": "saveDelayElapsed", "device": "B"},
        {"action": "focus", "device": "A"},
        {"action": "expectDevice", "device": "A", "version": 3, "grades": [5, 3], "selectedYear": 2, "unsynced": false},
        {"action": "open", "device": "A"},
        {"action": "open", "device": "B"},
        {"action": "expectDevice", "device": "A", "selectedYear": 2, "version": 3},
        {"action": "expectDevice", "device": "B", "selectedYear": 3, "version": 3}
      ]
    },
    {
      "name": "a device connecting starts on the year last saved, then keeps its own",
      "steps": [
        {"action": "open", "device": "A", "fixture": "fms-student"},
        {"action": "createCode", "device": "A"},
        {"action": "selectYear", "device": "A", "year": 2},
        {"action": "addGrade", "device": "A", "value": 5},
        {"action": "saveDelayElapsed", "device": "A"},
        {"action": "connect", "device": "B"},
        {"action": "expectDevice", "device": "B", "selectedYear": 2, "grades": [5]},
        {"action": "selectYear", "device": "B", "year": 1},
        {"action": "selectYear", "device": "A", "year": 3},
        {"action": "addGrade", "device": "A", "value": 4},
        {"action": "saveDelayElapsed", "device": "A"},
        {"action": "focus", "device": "B"},
        {"action": "expectDevice", "device": "B", "selectedYear": 1, "grades": [5, 4]}
      ]
    },
    {
      "name": "a reconciliation-only difference causes no sync and no conflict",
      "steps": [
        {"action": "open", "device": "A", "fixture": "fms-student"},
        {"action": "createCode", "device": "A"},
        {"action": "connect", "device": "B"},
        {"action": "reconcile", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "saved", "unsynced": false, "version": 1},
        {"action": "saveDelayElapsed", "device": "A"},
        {"action": "open", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "saved", "failure": null, "unsynced": false, "version": 1},
        {"action": "expectCloud", "version": 1, "grades": []},
        {"action": "open", "device": "B"},
        {"action": "expectDevice", "device": "B", "status": "saved", "failure": null, "unsynced": false, "version": 1},
        {"action": "addGrade", "device": "B", "value": 3},
        {"action": "saveDelayElapsed", "device": "B"},
        {"action": "focus", "device": "A"},
        {"action": "expectDevice", "device": "A", "status": "saved", "unsynced": false, "version": 2, "grades": [3]}
      ]
    }
  ]
}
